{
  "name": "reeve",
  "version": "0.1.0",
  "private": true,
  "description": "Sonnet-supervised qwen task loop: qwen2.5:3b makes atomic file edits, Sonnet decomposes tasks and reviews the output, on a self-hosted GitHub Actions runner.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --write src tests scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesmyers4/Reeve.git"
  },
  "bugs": {
    "url": "https://github.com/jamesmyers4/Reeve/issues"
  },
  "homepage": "https://github.com/jamesmyers4/Reeve#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
